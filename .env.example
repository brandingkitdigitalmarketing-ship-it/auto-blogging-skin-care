# ==============================================================
# ENVIRONMENT CONFIGURATION - LUMIÈRE DERMA JOURNAL
# ==============================================================

NODE_ENV=production
PORT=3000

# Website Base URL
NEXT_PUBLIC_SITE_URL=https://yourskincaredomain.com

# AI API Providers (Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=builtin

# Auto-Blogging Publishing Security
CRON_SECRET=your_super_secret_cron_token_here

# Admin Portal Security
ADMIN_SECRET_KEY=admin_secure_secret_passphrase

# Optional WordPress Sync Integration (if syncing to WordPress)
WP_SITE_URL=https://your-wordpress-site.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Analytics & Search Console (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
